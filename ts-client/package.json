{
  "name": "@meteora-ag/dlmm",
  "version": "1.9.4",
  "description": "",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeteoraAg/dlmm-sdk.git",
    "directory": "ts-client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "start": "npm run build -- --watch",
    "test": "jest 'src/test/sdk_token2022.test.ts'",
    "test:all": "jest",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:package": "pnpm build && jest --config jest.package.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit",
    "unit-test": "pnpm test:unit",
    "example": "dotenv -e .env npx ts-node src/examples/example.ts",
    "start-server": "npx tsc && node dist/src/server/index.js"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@types/babar": "^0.2.1",
    "@types/bn.js": "^5.1.5",
    "@types/express": "^4.17.21",
    "@types/gaussian": "^1.2.0",
    "@types/jest": "^29.5.2",
    "babar": "^0.2.3",
    "babel-jest": "^29.5.0",
    "dotenv-cli": "^7.2.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@coral-xyz/borsh": "0.32.1",
    "@solana/buffer-layout": "^4.0.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "gaussian": "^1.3.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.15.0"
    }
  },
  "keywords": [],
  "author": "McSam",
  "license": "ISC"
}
